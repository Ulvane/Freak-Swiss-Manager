{
  "name": "free-swiss-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run typecheck && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types",
    "benchmark:generate": "node scripts/generate-benchmark-cache.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:verify:remote": "wrangler d1 execute DB --remote --command \"SELECT t.visibility, t.archived_at, p.withdrawn_from_round, ps.token_hash, ua.email, ac.password_iterations, session.expires_at FROM tournaments t LEFT JOIN players p ON p.tournament_id = t.id LEFT JOIN player_sessions ps ON ps.tournament_id = t.id LEFT JOIN user_accounts ua ON ua.email = t.owner_email LEFT JOIN auth_credentials ac ON ac.email = ua.email LEFT JOIN auth_sessions session ON session.email = ua.email LIMIT 0\"",
    "deploy": "npm run db:migrate:remote && npm run db:verify:remote && vinext-cloudflare deploy --skip-build"
  },
  "dependencies": {
    "@echecs/swiss": "^5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module",
  "displayName": "Freak Swiss Manager"
}
