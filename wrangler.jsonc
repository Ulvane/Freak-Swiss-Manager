{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freak-swiss-manager",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "92841001", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "92841002", "simple": { "limit": 300, "period": 60 } },
    { "name": "READ_RATE_LIMITER", "namespace_id": "92841003", "simple": { "limit": 1200, "period": 60 } }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freak-swiss-db",
      "database_id": "6b75b4c8-a8e4-434d-ad68-a0f50e0424ee",
      "migrations_dir": "drizzle"
    }
  ]
}
